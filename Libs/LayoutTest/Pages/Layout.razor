@page "/layout"


<div class="game-view">

    @* Horizontale Flexbox *@
    <div class="flexbox-1">

        @* Verticale Flexbox *@
        <div class="verticale-flexbox-1">
            <div class="child-1"/>
            <div class="child-2"/>
            <div class="child-3"/>
        </div>    
    </div>
    <div class="flexbox-2">
        @* Horizontale Flexbox *@
        <div class="horizontale-flexbox-2-1">
            <div class="column-1" >
            </div>

            @* Verticale Flexbox *@
            <div class="column-2" >
                <div class="top-10">

                </div>
                <div class="grid-columns-80">
                    @for (int row = 0; row < 16; row++)
                    {
                        @for (int col = 0; col < 16; col++)
                        {
                            var cellKey = $"cell-{row}-{col}";
                            <div class="cell" @key="cellKey"></div>
                        }
                    }
                </div>
                <div class="bottom-10">
                </div>
            </div>
            <div class="column-3">
            </div>
        </div>
    </div>

    <div class="flexbox-3">
        @* Verticale Flexbox *@
        <div class="verticale-flexbox-2">
            <div class="child-4" />
            <div class="child-5" />
            <div class="child-6" />
        </div>
    </div>
</div>
